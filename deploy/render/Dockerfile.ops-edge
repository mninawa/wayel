# syntax=docker/dockerfile:1.7
#
# Render Docker web service: WeYell ops dashboard edge.
#
# Pure SPA + nginx. The ops dashboard authenticates directly against the
# API with a Bearer JWT (no BFF, no first-party cookies), so the only thing
# nginx does is:
#
#   * Serve the Angular bundle at /
#   * Reverse-proxy /api/ to the wayel-api Render service over HTTPS so the
#     browser never has to cross an origin (CORS-free).
#
# Build context: REPO ROOT.
#
#   docker build -f deploy/render/Dockerfile.ops-edge .

# ──────────────────────────────────────────────────────────────────────────
# Stage 1: Angular build (we-yell-ops-dash, `production` configuration).
# ──────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS spa-build
WORKDIR /spa

COPY frontend/package.json frontend/package-lock.json ./
COPY frontend/apps/we-yell-ops-dash/package.json apps/we-yell-ops-dash/
COPY frontend/packages/shared/package.json packages/shared/

RUN npm ci

COPY frontend/packages/shared packages/shared
COPY frontend/apps/we-yell-ops-dash apps/we-yell-ops-dash

RUN npm run build --workspace @weyell/we-yell-ops-dash -- --configuration production

# ──────────────────────────────────────────────────────────────────────────
# Stage 2: nginx runtime. gettext-base is needed for envsubst at boot so we
# can inject the upstream API host and $PORT from Render at start time
# rather than at build time (lets us reuse the same image for stage / prod).
# ──────────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

RUN apk add --no-cache gettext bash \
 && rm -f /etc/nginx/conf.d/default.conf

COPY --from=spa-build /spa/apps/we-yell-ops-dash/dist/we-yell-ops-dash/browser /usr/share/nginx/html
COPY deploy/render/nginx.ops-edge.conf.template /etc/nginx/templates/nginx.conf.template
COPY deploy/render/start-ops-edge.sh /start-ops-edge.sh
RUN chmod +x /start-ops-edge.sh

# Render injects $PORT (default 10000) and we read $API_UPSTREAM_HOST off
# the service env (e.g. wayel-api.onrender.com) — see render.yaml.
ENV PORT=10000 \
    API_UPSTREAM_HOST=wayel-api.onrender.com

EXPOSE 10000

CMD ["/start-ops-edge.sh"]
