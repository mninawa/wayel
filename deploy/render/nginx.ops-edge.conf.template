# WeYell ops-dashboard edge — listens on $PORT, serves the Angular ops SPA
# at /, reverse-proxies /api/ to https://$API_UPSTREAM_HOST/api/.
#
# Why a server-side proxy instead of pointing the SPA at the API host
# directly:
#
#   * Browsers never see a cross-origin call, so the API doesn't need a
#     CORS allow-list with this exact host (one less coupling between the
#     two services in Render).
#   * Render's free TLS terminates at this nginx, so the upstream call
#     happens entirely inside Render's network over HTTPS — encryption
#     stays end-to-end.
#
# The upstream host is parameterised so a single image works for stage,
# prod, and review environments — only the env var changes.

resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

map $http_x_forwarded_proto $forwarded_proto {
    "~^https?$" $http_x_forwarded_proto;
    default $scheme;
}

map $http_x_forwarded_host $forwarded_host {
    default $http_x_forwarded_host;
    '' $host;
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Ops uploads (KYC IDs, parcel photos) routinely exceed the default
    # 1 MB nginx body limit. Match the API.
    client_max_body_size 25m;
    client_header_buffer_size 16k;
    large_client_header_buffers 8 32k;

    # ── API proxy ─────────────────────────────────────────────────────
    # `set` + variable in proxy_pass forces nginx to re-resolve the
    # upstream host via the configured resolver instead of caching the
    # IP it picked up at startup. Render's load-balancer IPs rotate, so
    # caching produces stale-IP 502s after a few hours.
    location /api/ {
        set $api_upstream ${API_UPSTREAM_HOST};
        proxy_pass https://$api_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $api_upstream;
        proxy_ssl_server_name on;
        proxy_ssl_name $api_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $forwarded_host;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }

    # ── SPA ───────────────────────────────────────────────────────────
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|mjs)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
