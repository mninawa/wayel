# syntax=docker/dockerfile:1.7
#
# Deployable WeYell Ops Dashboard: Angular build + nginx proxy to BFF.
# Build context: frontend/
#   docker build -f apps/we-yell-ops-dash/Dockerfile.deploy .

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/we-yell-ops-dash/package.json apps/we-yell-ops-dash/
COPY packages/shared/package.json packages/shared/

RUN npm ci

COPY packages/shared packages/shared
COPY apps/we-yell-ops-dash apps/we-yell-ops-dash

RUN npm run build --workspace @weyell/we-yell-ops-dash -- --configuration docker

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx-spa-ops.compose.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/we-yell-ops-dash/dist/we-yell-ops-dash/browser /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
