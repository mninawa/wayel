# syntax=docker/dockerfile:1.7
#
# Dedicated Dockerfile for the Wayel.Api host. Equivalent to invoking the
# parameterised root `Dockerfile` with PROJECT=src/Wayel.Api/Wayel.Api.csproj
# but lives next to the per-BFF Dockerfiles so all four hosts can be built
# with the same `docker build -f Dockerfile.<host>` shape.

# ---- build stage ----
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore first for layer caching. We copy every csproj so the project graph
# resolves before we start hauling in the full source tree.
COPY Directory.Build.props Directory.Packages.props global.json ./
COPY src/Wayel.Domain/Wayel.Domain.csproj                 src/Wayel.Domain/
COPY src/Wayel.Application/Wayel.Application.csproj       src/Wayel.Application/
COPY src/Wayel.Infrastructure/Wayel.Infrastructure.csproj src/Wayel.Infrastructure/
COPY src/Wayel.Api/Wayel.Api.csproj                       src/Wayel.Api/
RUN dotnet restore src/Wayel.Api/Wayel.Api.csproj

COPY src/Wayel.Domain         src/Wayel.Domain
COPY src/Wayel.Application    src/Wayel.Application
COPY src/Wayel.Infrastructure src/Wayel.Infrastructure
COPY src/Wayel.Api            src/Wayel.Api
RUN dotnet publish src/Wayel.Api/Wayel.Api.csproj -c Release -o /app/publish \
    /p:UseAppHost=false /p:DebugType=none /p:DebugSymbols=false

# ---- runtime stage ----
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

RUN groupadd --gid 10001 wayel \
 && useradd --uid 10001 --gid wayel --shell /usr/sbin/nologin --no-create-home wayel \
 && chown -R wayel:wayel /app
USER wayel

ENV ASPNETCORE_URLS=http://0.0.0.0:8080 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_EnableDiagnostics=0
EXPOSE 8080

# Probe liveness only — readiness can flap under load and we don't want the
# container runtime to restart the host for a transient Mongo blip. The
# aspnet:10.0 image ships no curl/wget, so we use bash's built-in /dev/tcp
# pseudo-device to confirm Kestrel is bound.
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080' || exit 1

ENTRYPOINT ["dotnet", "Wayel.Api.dll"]
