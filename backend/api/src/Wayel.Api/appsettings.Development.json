{
  // Local-developer overrides for Wayel.Api.
  //
  // Secrets (Mongo connection, JWT signing key, Google OAuth client ids)
  // are loaded from env vars or `dotnet user-secrets` — never committed.
  //
  // Docker compose path: values flow in from `backend/api/.env`.
  // Host-run path:       hydrate with `dotnet user-secrets set …`
  //                      (see `.secrets.local/wayel-api-config.md`).
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Mongo": {
    // MongoDB Atlas connection. Set via `Mongo__ConnectionString` env var or
    // `dotnet user-secrets set "Mongo:ConnectionString" "<srv-uri>"`.
    "ConnectionString": "",
    "DatabaseName": "kids_platform"
  },
  "Jwt": {
    // Dev signing key. Set via `Jwt__SigningKey` env var or
    // `dotnet user-secrets set "Jwt:SigningKey" "<32+ char secret>"`.
    "SigningKey": "",
    "Issuer": "wayel-api-dev",
    "Audience": "wayel-clients-dev"
  },
  "GoogleAuth": {
    // Client ids the API accepts on POST /api/v1/auth/sso/google. Each BFF's
    // GoogleOidc.ClientId must appear here. Populate via env vars
    // (GOOGLEAUTH__CLIENTIDS__0..N — remember to set ALL indices when
    // overriding, see docker-compose.yml) or `dotnet user-secrets`.
    //   [0] REMOVED    (localhost:5199)
    //   [1] Wayel.Bff.Customer   (localhost:5198)
    //   [2] REMOVED (localhost:5197)
    "ClientIds": []
  },
  "Auth": {
    "Sso": {
      // First-run super-admin bootstrap: the first matching email to complete
      // Google SSO is auto-promoted to SuperAdmin and implicitly admitted.
      "BootstrapSuperAdmins": [
        "mninawa@gmail.com"
      ],
      "AdminPortal": {
        // Standing admission rules for the admin BFF audience (in addition
        // to bootstrap super-admins and any non-expired pending invitations).
        "AllowedEmails": [
          "mninawa@gmail.com"
        ],
        "AllowedDomains": []
      },
      // Bootstrap-tenant-admin: emails listed here are auto-promoted to
      // TenantAdmin and bound to the named tenant on first SSO into the
      // Client BFF (staff portal).
      //
      // SINGLE-ROLE CAVEAT: promoting an existing Parent account here will
      // overwrite their Parent role. Until multi-role lands, use a SEPARATE
      // Google account for staff vs. parent testing. Add an entry below to
      // enable, e.g.:
      //   { "Email": "you+staff@yourdomain.com", "TenantId": "019dba00-0000-7000-9000-000000000001" }
      "BootstrapTenantAdmins": []
    }
  },
