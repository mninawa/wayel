  "Notifications": {
    // Per-role invitation accept URLs. The plaintext token is appended as
    // ?token=…. Roles match the UserRole enum (case-insensitive); roles
    // not listed fall back to AcceptUrlBase.
    //
    // These hosts must match where the SPAs are actually served — the
    // dockerised dev stack (docker-compose.localhost.yml) puts:
    //
    //   :8081 → admin portal  (SuperAdmin / TenantAdmin / Staff)
    //   :8082 → external client (parents + public marketing)
    //   :8083 → client BFF SPA (TBD)
    //
    // Both portals mount the shared `WayelAcceptInvitationComponent`
    // at `/invitations/accept`, so the only choice is which origin the
    // recipient lands on (and therefore which BFF cookie / OIDC session
    // they end up with after accept). Staff land on the admin portal
    // alongside the TenantAdmin who invited them — the workspace UI is
    // their primary surface.
    "AcceptUrlBase": "http://localhost:8081/invitations/accept",
    "AcceptUrlBaseByRole": {
      "SuperAdmin": "http://localhost:8081/invitations/accept",
      "TenantAdmin": "http://localhost:8081/invitations/accept",
      "Staff": "http://localhost:8081/invitations/accept",
      "Parent": "http://localhost:8082/invitations/accept",
      // Co-parent invitations land on the dedicated /co-parents/accept
      // page in the external SPA — NOT the staff /invitations/accept
      // flow. Without this entry the URL builder falls through to
      // AcceptUrlBase (the global default at :8081/invitations/accept)
      // and the recipient lands on the wrong screen.
      "CoParent": "http://localhost:8082/co-parents/accept"
    },
    // Outbound email transport. Resend is the default — domain-only
    // verification (vs SES sandbox per-recipient verification) means
    // the dev box can mail any test gmail without dance. Flip to
    // "ses" to exercise the SES path against the existing identity.
    "Provider": "postmark",
    // Provider-agnostic envelope. The address must be on a Postmark-
    // verified Sender Signature / DKIM domain (or a Resend-verified
    // domain when Provider="resend", or the SES verified-identity list
    // when Provider="ses").
    "Email": {
      "Enabled": true,
      "FromAddress": "mninawa@felidaen.co",
      "FromDisplayName": "Wayel"
    },
    // Postmark server token MUST come from env (POSTMARK_SERVER_TOKEN →
    // docker-compose maps it to Notifications__Postmark__ServerToken).
    // Never commit. Provision at:
    //   https://account.postmarkapp.com/account/api_tokens
    "Postmark": {
      "ServerToken": "",
      "MessageStream": "outbound",
      "ApiBaseUrl": "https://api.postmarkapp.com"
    },
    // Resend kept wired for fallback; flipping Provider back to
    // "resend" is a one-line change. ApiKey MUST come from env
    // (RESEND_API_KEY → Notifications__Resend__ApiKey). Never commit.
    "Resend": {
      "ApiKey": "",
      "ApiBaseUrl": "https://api.resend.com"
    },
    // AWS SES kept here for fallback; disabled while Postmark is the
    // primary transport so the SES options validator doesn't bark
    // when AWS creds aren't loaded.
    "Ses": {
      "Enabled": false,
      "Region": "eu-west-1",
      "FromAddress": "mninawa@felidaen.co",
      "FromDisplayName": "Wayel",
      "ConfigurationSetName": "Dev"
    },
    // WhatsApp via WasenderAPI (https://wasenderapi.com). Disabled by
    // default in dev so local smoke tests fall through to the console
    // sender; flip Enabled=true once the ApiKey is populated via env
    // (NOTIFICATIONS__WASENDER__APIKEY). The Allowlist is the safety
    // net — only those E.164 numbers will actually be messaged when
    // Enabled=true; everyone else logs a warning and short-circuits
    // success.
    "WaSender": {
      "Enabled": false,
      "ApiKey": null,
      "BaseUrl": "https://wasenderapi.com",
      "Allowlist": []
    },
    // Webhook signature verification. In dev we POST hand-crafted
    // fixtures against `/api/v1/webhooks/notifications/{ses,whatsapp}`,
    // so we keep the strong checks off and rely on the optional
    // shared header (`Secret`) instead.
    //
    // In production:
    //   • set VerifySnsSignatures=true (default) and leave Secret empty —
    //     the AWS SDK util pins the signing cert host to *.amazonaws.com.
    //   • set WaSenderSecret to the value configured as the session's
    //     "Webhook Secret" on the Wasender dashboard; every callback is
    //     then constant-time-compared against the X-Webhook-Signature
    //     header.
    "Webhooks": {
      "Secret": null,
      "VerifySnsSignatures": false,
      "WaSenderSecret": null
    }
  },
  "Outbox": {
    // Faster poll than prod so dev event-driven flows feel snappy.
    "PollInterval": "00:00:01",
    "Archive": {
      // Filesystem archive sink writes JSON-Lines per UTC day under RootPath.
      // Disabled by default; flip Enabled=true to exercise the
      // OutboxArchiveHostedService end-to-end locally.
      "Enabled": false,
      "PollInterval": "00:01:00",
      "ArchiveAfter": "00:05:00",
      "BatchSize": 100,
      "RootPath": "./.dev/outbox-archive"
    }
  },
  "Billing": {
    // Paystack integration. SecretKey MUST come from env
    // (BILLING__PAYSTACK__SECRETKEY). Never commit a `sk_…` key.
    //
    // Local dev posture:
    //   * Enabled=true so the typed `IPaymentGateway` resolves;
    //     when SecretKey is blank the adapter surfaces a typed
    //     `payment_gateway.misconfigured` error instead of throwing.
    //   * VerifyChargeMinorUnits=100 means a R1 verify charge per
    //     add-card flow; auto-refunded by RefundVerifyCharge=true.
    //   * CallbackUrl is the SPA page that calls /confirm with the
    //     reference Paystack appends as ?reference=… on redirect.
    "Paystack": {
      "Enabled": true,
      "SecretKey": "",
      "PublicKey": "",
      "ApiBaseUrl": "https://api.paystack.co",
      "Currency": "ZAR",
      "VerifyChargeMinorUnits": 100,
      "CallbackUrl": "http://localhost:8082/parent/profile/payment-methods/added",
      "RefundVerifyCharge": true,
      "SubscriptionsEnabled": true,
      "WebhookSecret": ""
    },
    // Platform-side billing knobs. DefaultCommissionBps drives the
    // 5% Wayel platform fee that's added to every parent charge —
    // the institution's portion is settled directly to its Paystack
    // subaccount via TransactionSplit, the platform fee lands in
    // Wayel's own settlement account. 500 bps = 5%. Bump cautiously;
    // existing periods carry the snapshot from approval time so a
    // mid-flight rate change won't retroactively re-price open
    // contracts.
    "Platform": {
      "DefaultCommissionBps": 500
    },
    // MTN MoMo (sandbox). Local-dev posture:
    //   * Enabled=true + AllowSimulatedPayments=true lets the SPA exercise
    //     the MoMo flow without real MTN credentials — Initiate returns a
    //     "pending" stub and Verify returns "success" immediately.
    //   * To run against MTN's actual sandbox, set:
    //       BILLING__MTNMOMO__SUBSCRIPTIONKEY=<your Collections primary key>
    //       BILLING__MTNMOMO__AUTOPROVISIONSANDBOX=true (provisions ApiUser/ApiKey at startup)
    //     and clear AllowSimulatedPayments.
    //   * Production deployment overrides BaseUrl to https://proxy.momoapi.mtn.com,
    //     TargetEnvironment to "mtnswaziland", Currency to "SZL", and supplies
    //     ApiUser / ApiKey via env from MTN's commercial onboarding pack.
    "MtnMomo": {
      "Enabled": true,
      "BaseUrl": "https://sandbox.momodeveloper.mtn.com",
      "TargetEnvironment": "sandbox",
      "SubscriptionKey": "",
      "DisbursementsSubscriptionKey": "",
      "ApiUser": "",
      "ApiKey": "",
      "Currency": "EUR",
      "CallbackHost": "localhost",
      "AllowSimulatedPayments": true,
      "AutoProvisionSandbox": false,
      "PerTransactionMinorUnitsLimit": 500000
    }
  },
  "MediaStorage": {
    // Dev now defaults to real AWS S3 (matches prod). For
    // contributors who don't yet have a dev bucket, the cleanest
    // fallback is the in-memory backend — set
    //   MediaStorage__Provider=in-memory
    // in your env / appsettings.Development.local.json and uploads
    // will land in the process-local store again.
    //
    // Required for the s3 path (set via env vars; docker-compose
    // forwards them from .env — see backend/api/.env.example):
    //   MediaStorage__Region          e.g. "eu-west-1"
    //   MediaStorage__BucketName      e.g. "wayel-dev-shared"
    //   MediaStorage__CdnHost         e.g. "media.dev.wayel.dev"
    //   AWS_ACCESS_KEY_ID             dev IAM user with PutObject/GetObject on the bucket
    //   AWS_SECRET_ACCESS_KEY         (or omit both if the AWS_PROFILE / IAM-role chain resolves)
    //
    // The S3MediaStorage backend throws a clear error at first
    // upload if Region / BucketName / CdnHost are missing — silent
    // misconfiguration is rejected by design.
    "Provider": "in-memory",
    "Environment": "dev",
    "BucketTemplate": "wayel-{env}-{slug}-{guid8}"
  },
  "BorderBox": {
    "CustomerPortalBaseUrl": "http://localhost:8080",
    "Pricing": {
      "ChargeVat": true,
      "ChargeWeightSurcharge": false
    }
  },
  "ForwardedHeaders": {
    "TrustAllProxies": true
  }
}
