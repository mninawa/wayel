# -----------------------------------------------------------------------------
# Wayel backend .env (consumed by docker compose).
#
# Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit credentials.
#
# Compose substitutes ${VAR} into the `environment:` block of each service
# at `docker compose up` time. The API container then reads them as the
# usual `Mongo__ConnectionString` / `Mongo__DatabaseName` config keys.
# -----------------------------------------------------------------------------

# MongoDB Atlas connection string. Use the SRV form Atlas hands you in
# "Connect → Drivers → C# / .NET". The driver does its own DNS lookup, so
# nothing extra is needed for compose networking.
#
#   1. Atlas → Database → Connect → Drivers
#   2. Pick C# / .NET, copy the connection string.
#   3. Replace <username>, <password>, and <cluster-host> below.
#   4. Make sure the source IP (your laptop's public IP, or 0.0.0.0/0 for
#      a dev cluster) is on the Atlas Network Access allow-list.
MONGO_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=Wayel

# Database name inside the Atlas cluster. Defaults to "wayel" if omitted.
MONGO_DATABASE_NAME=wayel

# JWT signing key used by the core API to mint access/refresh tokens.
# Must be at least 32 characters. Override per-environment in real deploys.
JWT_SIGNING_KEY=compose-only-signing-key-must-be-at-least-32-chars-long

# -----------------------------------------------------------------------------
# Media storage (S3)
#
# The API ships with the S3 backend enabled by default in dev so that
# bytes land in the same place they will in prod (per-tenant prefix:
# {tenantId}/{scope}/{ownerType}/{ownerId}/{guid}.{ext}).
#
# To run without an AWS account (e.g. during a quick local hack), flip
# MEDIA_STORAGE_PROVIDER to "in-memory":
#
#     MEDIA_STORAGE_PROVIDER=in-memory
#
# Otherwise fill in the four values below. The S3 backend will throw a
# clear error at first upload if any of Region / Bucket / CdnHost are
# missing.
#
# Bucket policy + CORS + IAM are managed in our infra repo. The
# values below just point the API at that bucket; credentials are
# expected to come from the developer's local AWS profile (the
# default SDK chain picks them up automatically).
# -----------------------------------------------------------------------------

# Provider selector. "s3" (default) or "in-memory".
MEDIA_STORAGE_PROVIDER=s3

# AWS region the bucket lives in.
MEDIA_STORAGE_REGION=eu-west-1

# Bucket bytes get written to. The shared dev/staging bucket lives
# at `nestiq-kids-platform`; per-environment overrides should set
# this to their own bucket name.
MEDIA_STORAGE_BUCKET=we-yell-courier-platform

# CDN host used in persisted read URLs (`https://{host}/{key}`). Prefer your
# CloudFront distribution hostname when the bucket is private behind OAC
# (e.g. `dxxxxxxxxxxxxx.cloudfront.net`). Without CloudFront — only if GetObject
# is allowed on the bucket — you can fall back to the regional endpoint:
#   nestiq-kids-platform.s3.eu-west-1.amazonaws.com
MEDIA_STORAGE_CDN_HOST=d1uqzemvshg76c.cloudfront.net

# Environment token used in the per-tenant bucket name template
# (wayel-{env}-{slug}-{guid8}). Defaults to "dev".
MEDIA_STORAGE_ENVIRONMENT=dev

# AWS credentials. Leave these blank to fall back to the SDK's
# default credentials chain (~/.aws/credentials profile, IAM role,
# etc.) — that's how the dev workflow is set up today. Only set
# them inline for one-off scripts where the profile chain isn't
# available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# -----------------------------------------------------------------------------
# Outbound email (Postmark by default; Resend and AWS SES still wired
# as fallbacks).
#
# Postmark is the primary provider — domain or Sender-Signature
# verification + a server-scoped token is enough to mail any external
# recipient (no SES-style per-recipient sandbox). Flip
# NOTIFICATIONS_PROVIDER to "resend" or "ses" to exercise the
# alternate paths without rebuilding the image.
#
# 1. Sign up at postmarkapp.com, create a "Wayel" server, and verify
#    either a Sender Signature (single mailbox) or a sending domain
#    (DKIM/Return-Path TXT records via the Postmark dashboard).
# 2. Issue a server-scoped API token at:
#       https://account.postmarkapp.com/account/api_tokens
#    (NOT the account-level token — it can't send mail.)
# 3. Set the From address to a mailbox covered by the verified
#    Signature / domain.
# -----------------------------------------------------------------------------

# Email transport selector. One of "postmark" (default), "resend", "ses".
NOTIFICATIONS_PROVIDER=postmark

# Postmark server token — required when NOTIFICATIONS_PROVIDER=postmark.
# Looks like a UUID (`xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx`).
POSTMARK_SERVER_TOKEN=

# Postmark message stream. Keep on "outbound" for transactional
# invitations; only override if an operator deliberately reconfigures
# the Postmark server with a custom stream.
POSTMARK_MESSAGE_STREAM=outbound

# Resend API key — required when NOTIFICATIONS_PROVIDER=resend.
# Format: re_…
RESEND_API_KEY=

# Verified From identity. Must be covered by the active provider's
# verification (Postmark Sender Signature / verified domain, Resend
# verified domain, or SES verified identity).
NOTIFICATIONS_FROM_ADDRESS=notifications@your-verified-domain.com
NOTIFICATIONS_FROM_DISPLAY_NAME=Wayel

# Legacy AWS SES settings — only consulted when NOTIFICATIONS_PROVIDER=ses.
# Notifications__Ses__Enabled=true
# Notifications__Ses__Region=eu-west-1
# Notifications__Ses__FromAddress=notifications@your-verified-domain.com
# Notifications__Ses__FromDisplayName=Wayel
# Notifications__Ses__ConfigurationSetName=

# -----------------------------------------------------------------------------
# Invitation WhatsApp (WasenderAPI)
#
# When Notifications__WaSender__Enabled=true the API sends WhatsApp messages
# via WasenderAPI (https://wasenderapi.com) — a QR-linked WhatsApp session,
# NOT Meta's official Cloud API. There are no approved templates: every
# message is rendered server-side as plain text.
#
# Setup:
#   1. Sign up at https://wasenderapi.com and create a session.
#   2. Open the session, scan the QR code from the WhatsApp account that
#      should be the "from" identity for outbound messages.
#   3. Copy the per-session API key from the dashboard into
#      NOTIFICATIONS__WASENDER__APIKEY below.
#   4. Webhook URL: https://<your-api-host>/api/v1/webhooks/notifications/whatsapp
#      Set the matching session "Webhook Secret" and copy it into
#      NOTIFICATIONS__WEBHOOKS__WASENDERSECRET.
#
# Allowlist (NOTIFICATIONS__WASENDER__ALLOWLIST__0..N) gates dev sends to
# known E.164 numbers — anything not in the list logs a warning and
# short-circuits success. Leave empty in production.
#
# TOS note: WasenderAPI rides a personal-style WhatsApp session, so keep
# fan-out to recipients who expect us (invitations, subscription decisions
# tied to a parent who already started a conversation). Bulk cold sends
# can get the linked number disconnected or banned.
# -----------------------------------------------------------------------------

# NOTIFICATIONS__WASENDER__ENABLED=false
# NOTIFICATIONS__WASENDER__APIKEY=your-per-session-bearer-here
# NOTIFICATIONS__WASENDER__SUPPORTINBOXPHONEE164=27821234567

# Ops receiving-exception WhatsApp alerts (background job)
# BorderBox__OpsExceptionSupportAlerts__Enabled=true
# BorderBox__OpsExceptionSupportAlerts__OpsPortalBaseUrl=http://localhost:8081
# NOTIFICATIONS__WASENDER__BASEURL=https://wasenderapi.com
# NOTIFICATIONS__WASENDER__ALLOWLIST__0=+27115550123
# NOTIFICATIONS__WEBHOOKS__WASENDERSECRET=your-session-webhook-secret-here

# Optional S3-compatible service URL (LocalStack / MinIO). Leave
# blank for real AWS. When set, MEDIA_STORAGE_FORCE_PATH_STYLE must
# be true so the SDK doesn't try DNS-style bucket addressing.
# MEDIA_STORAGE_SERVICE_URL=http://localhost:4566
# MEDIA_STORAGE_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Payments (Paystack)
#
# 1. Create a Paystack account, switch to TEST mode in the dashboard.
# 2. Settings → API Keys & Webhooks → copy the Test Secret Key (`sk_test_…`)
#    and Test Public Key (`pk_test_…`) into the values below.
# 3. Same page, set the webhook URL to:
#       https://<your-api-host>/api/v1/billing/webhooks/paystack
#    Paystack signs every webhook with HMAC-SHA-512 using the SAME secret
#    key — no separate webhook secret to configure.
# 4. Test cards: https://paystack.com/docs/payments/test-payments/
#
# In dev `Billing__Paystack__SecretKey` may be blank; the API will boot
# fine and surface a typed `payment_gateway.misconfigured` error per
# call. Set it to exercise the live add-card flow against Paystack's
# sandbox.
# -----------------------------------------------------------------------------

# PAYSTACK_ENABLED=true
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAYSTACK_API_BASE_URL=https://api.paystack.co
# PAYSTACK_CURRENCY=ZAR
# PAYSTACK_VERIFY_MINOR_UNITS=100
# PAYSTACK_CALLBACK_URL=http://localhost:8082/parent/profile/payment-methods/added
# PAYSTACK_REFUND_VERIFY_CHARGE=true

# -----------------------------------------------------------------------------
# Payments (MTN MoMo Collections / Disbursements)
#
# MoMo is the second payment gateway, offered to Eswatini customers whose
# MSISDN matches an MTN Eswatini number (+268 7…). The customer-facing flow:
#   1. SPA calls /checkout/initiate → backend dispatches RequestToPay to MTN.
#   2. MTN pushes a USSD prompt to the customer's handset.
#   3. SPA shows "Approve on your phone" and polls /payments/{ref}/status.
#   4. On approval MTN POSTs to /webhooks/payments/momo/{ref} (we re-fetch
#      authoritative status to avoid trusting the unsigned callback body).
#
# Sandbox onboarding:
#   1. Register at https://momodeveloper.mtn.com → My Account → Subscriptions.
#   2. Subscribe to the "Collection" product. Copy the Primary Key →
#      BILLING__MTNMOMO__SUBSCRIPTIONKEY.
#      (Optionally subscribe to "Disbursement" for refunds/payouts and copy
#      its primary key into BILLING__MTNMOMO__DISBURSEMENTSSUBSCRIPTIONKEY.)
#   3. Set BILLING__MTNMOMO__AUTOPROVISIONSANDBOX=true to have the API
#      mint a sandbox API User + API Key at startup. Or manually run
#      curl https://sandbox.momodeveloper.mtn.com/v1_0/apiuser /apikey
#      and paste the resulting values into BILLING__MTNMOMO__APIUSER /
#      BILLING__MTNMOMO__APIKEY below.
#   4. Sandbox always settles in EUR; production Eswatini settles in SZL.
#
# Production onboarding:
#   * MTN's commercial team issues real ApiUser/ApiKey + production
#     subscription keys after KYB. Override BaseUrl to
#     https://proxy.momoapi.mtn.com and TargetEnvironment to "mtnswaziland".
#   * Whitelist the API's egress IP with MTN — otherwise every call
#     surfaces as MtnMomoForbiddenException (FORBIDDEN_IP).
# -----------------------------------------------------------------------------

# BILLING__MTNMOMO__ENABLED=true
# BILLING__MTNMOMO__BASEURL=https://sandbox.momodeveloper.mtn.com
# BILLING__MTNMOMO__TARGETENVIRONMENT=sandbox
# BILLING__MTNMOMO__SUBSCRIPTIONKEY=your-collections-primary-key
# BILLING__MTNMOMO__DISBURSEMENTSSUBSCRIPTIONKEY=your-disbursements-primary-key
# BILLING__MTNMOMO__APIUSER=
# BILLING__MTNMOMO__APIKEY=
# BILLING__MTNMOMO__CURRENCY=EUR
# BILLING__MTNMOMO__CALLBACKHOST=your-public-api-host.example.com
# BILLING__MTNMOMO__AUTOPROVISIONSANDBOX=true
# BILLING__MTNMOMO__ALLOWSIMULATEDPAYMENTS=false
# BILLING__MTNMOMO__PERTRANSACTIONMINORUNITSLIMIT=500000
