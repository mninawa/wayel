<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Required so IDE0005 ("Remove unnecessary usings") runs on build under
      EnforceCodeStyleInBuild. Roslyn intentionally skips IDE0005 unless a
      doc file is being produced (https://github.com/dotnet/roslyn/issues/41640).
      CS1591 is in WarningsNotAsErrors below so missing XML docs don't fail builds.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      Analyzer suppressions:
        CA1014 — assembly should be CLS-compliant. Backend services aren't.
        CA1716 — namespace name conflicts with VB reserved keyword (e.g. "Shared").
                 Wayel is a C#-only codebase; "Shared" / "Static" are fine.
        CA1848 — prefer LoggerMessage source-gen delegates. A handful of log
                 calls in BFF/host code don't justify the ergonomic cost.
        CA1873 — partner-rule of CA1848: "argument may be expensive when
                 logging is disabled". Same reasoning — opt out globally.
      Some of these only fire on newer SDK feature bands (>= 10.0.2xx);
      suppressing them keeps `dotnet publish` deterministic across local
      and Dockerfile (`mcr.microsoft.com/dotnet/sdk:10.0`) builds.
    -->
    <NoWarn>$(NoWarn);CA1014;CA1716;CA1848;CA1873</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit convention: Method_Scenario_ExpectedResult is best practice; CA1707 fights it. -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA1515</NoWarn>
  </PropertyGroup>

  <!--
    Targeted NuGet advisory suppressions. We only ever suppress an
    advisory when:
      1. The package is transitive (we don't import it directly), AND
      2. The vulnerable code path is not reachable from our usage, AND
      3. There is no fixed version on the public feed yet (or we are
         already on the latest), AND
      4. The advisory is moderate or lower.

    Each entry must carry a comment with the package, where it comes
    from, and why the code path is safe in our context.
  -->
  <ItemGroup>
    <!-- SharpCompress 0.40.0 (latest stable) is flagged by GHSA-6c8g-7p36-r338
         (zip-slip / path traversal during archive extraction). Pulled in
         transitively by Testcontainers' Docker image-layer extractor; we
         never extract attacker-controlled archives at runtime. We
         already pin to the latest stable in Directory.Packages.props;
         re-evaluate the suppression when SharpCompress publishes a
         release with the advisory's "fixed in" range bumped past 0.40.0. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6c8g-7p36-r338" />
  </ItemGroup>
</Project>
