# Root docker compose — copy to `.env` for overrides (optional).
# Defaults in docker-compose.yml work with the bundled MongoDB service.

# MongoDB (use bundled `mongo` service or Atlas)
# MONGO_CONNECTION_STRING=mongodb://mongo:27017/?directConnection=true
MONGO_DATABASE_NAME=borderbox

# JWT (min 32 chars)
JWT_SIGNING_KEY=local-dev-signing-key-must-be-at-least-32-chars

# Google OAuth client ID (required for real SSO; placeholder OK for local API boot)
GOOGLEAUTH__CLIENTIDS__0=000000000000-your-client-id.apps.googleusercontent.com

# Customer portal URL (BFF redirect / CORS)
BFF__SPA_BASE_URI=http://localhost:8080
