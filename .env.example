# Root docker compose — copy to `.env` for overrides (optional).
# Defaults in docker-compose.yml work with the bundled MongoDB service.

# MongoDB Atlas (recommended) — add compose file: -f docker-compose.atlas.yml
MONGO_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=<appName>
MONGO_DATABASE_NAME=courier_platform

# Local Mongo instead (also: --profile local-mongo)
# MONGO_CONNECTION_STRING=mongodb://mongo:27017/?directConnection=true
# MONGO_DATABASE_NAME=courier_platform

# JWT (min 32 chars)
JWT_SIGNING_KEY=local-dev-signing-key-must-be-at-least-32-chars

# Google OAuth clients (API validates ID tokens; list every OAuth client id you use)
# [0] Customer portal / BFF
GOOGLEAUTH__CLIENTIDS__0=1094311210896-s30kc67i68rfri54p6m7drm4soeshbe9.apps.googleusercontent.com
# [1] WeYell Ops dashboard — Authorized JavaScript origin: http://localhost:8081
GOOGLEAUTH__CLIENTIDS__1=1094311210896-54en0qs1uc5qu7qp977e0c9pgpqfalcr.apps.googleusercontent.com
GOOGLEOIDC__CLIENTID=1094311210896-s30kc67i68rfri54p6m7drm4soeshbe9.apps.googleusercontent.com
# From Google Cloud Console → Credentials → your OAuth client → Client secret
GOOGLEOIDC__CLIENTSECRET=
# OAuth Web client → Authorized redirect URIs (Docker portal):
#   http://localhost:8080/signin-oidc
# Authorized JavaScript origins:
#   http://localhost:8080

# Customer portal URL (BFF redirect / CORS)
BFF__SPA_BASE_URI=http://localhost:8080

# Demo personas (seeded on API startup when SEED_DEMO_DATA=true) — password demo1234
# See docs/DOCKER.md: new.google, ready.suite, active, expiring, sabelo, quote.done, inbox @weyell.demo
AUTH_ENABLE_PASSWORD_SIGNIN=true
SEED_DEMO_DATA=true
# Lets signed-in customers seed 6 ready-to-ship test parcels (Create Shipment page)
SEED_ALLOW_TEST_PARCELS=true

# BorderBox pricing (first API boot only — seeds Mongo `borderbox_pricing_config`; change later via ops API or UI)
# BORDERBOX_CHARGE_VAT=true
# VAT and import duty use R10,000 thresholds (duty per item, VAT on total purchase — see pricing config).
# BORDERBOX_CHARGE_WEIGHT_SURCHARGE=false
# Ops update: PUT /api/v1/borderbox/ops/pricing/config  Header: X-Wayel-Ops-Key: <KYC_OPS_API_KEY>

# Parcel invoice + KYC document uploads — use in-memory locally unless AWS keys are set.
# When MEDIA_STORAGE_PROVIDER is unset and a region + bucket + AWS credentials are present
# the API will pick S3 automatically. KYC docs (POPIA): once a customer is verified the
# API deletes the front/back ID images from the bucket and retains only the selfie.
MEDIA_STORAGE_PROVIDER=in-memory
# MEDIA_STORAGE_PROVIDER=s3
MEDIA_STORAGE_REGION=eu-west-1
MEDIA_STORAGE_BUCKET=we-yell-courier-platform
MEDIA_STORAGE_CDN_HOST=d1uqzemvshg76c.cloudfront.net
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Paystack (suite checkout) — get keys from https://dashboard.paystack.com
# Callback URL in Paystack dashboard is not required (we pass callback_url per transaction).
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_ALLOW_SIMULATED=true

# KYC — customer submit stays Pending until ops approves (set true to skip review in dev)
KYC_AUTO_VERIFY_ON_SUBMIT=false
# When ID Analyzer returns accept, auto-verify (requires ID Analyzer enabled + API key)
# KYC_AUTO_APPROVE_ON_PROVIDER_PASS=false
# ID Analyzer — https://developer.idanalyzer.com (POST /scan on submit + ops run-checks)
# KYC_IDANALYZER_ENABLED=true
# IDANALYZER_API_KEY=
# IDANALYZER_PROFILE_ID=security_medium
# IDANALYZER_BASE_URL=https://api2.idanalyzer.com
# Ops queue: http://localhost:8080/internal/kyc-review (header X-Wayel-Ops-Key)
KYC_OPS_API_KEY=weyell-local-kyc-ops
# Optional role-specific ops keys (local): weyell-ops-clerk, weyell-ops-finance

# WhatsApp via WasenderAPI — required for parcel-received alerts from ops receiving
# 1. Create session at https://wasenderapi.com and scan QR with your WhatsApp
# 2. Copy the per-session API key into NOTIFICATIONS__WASENDER__APIKEY
# 3. Set NOTIFICATIONS__WASENDER__ENABLED=true
# 4. Optional dev safety: NOTIFICATIONS__WASENDER__ALLOWLIST__0=+27... (empty = all numbers when enabled)
NOTIFICATIONS__WASENDER__ENABLED=false
NOTIFICATIONS__WASENDER__APIKEY=
NOTIFICATIONS__WASENDER__BASEURL=https://www.wasenderapi.com
NOTIFICATIONS__WASENDER__SESSIONID=
NOTIFICATIONS__WEBHOOKS__WASENDERSECRET=
# Dev safety: only these E.164 numbers receive WhatsApp (empty = allow all when enabled)
# NOTIFICATIONS__WASENDER__ALLOWLIST__0=+26876123456
# Ops WhatsApp that receives every new portal support ticket (E.164)
# NOTIFICATIONS__WASENDER__SUPPORTINBOXPHONE=+26876123456
# Customer portal link in WhatsApp messages (parcel received, etc.)
# PUBLIC_URL=http://localhost:8080
