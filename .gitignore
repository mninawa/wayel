.angular/

# Flutter / Dart
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Mobile env files: shared `local.json` / `prod.json` / `staging.json`
# are committed (consumed by --dart-define-from-file). Personal,
# device-specific overrides go into `*.local.json` and stay out of git
# — handy for "I'm pointing at a LAN IP today" without rewriting the
# shared file.
**/mobile-flutter/env/*.local.json

# IDE / editors
.idea/
.vs/
*.suo
*.userprefs
*.swp
.DS_Store

# Env (keep template files committable)
.env
.env.*
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

# Local-only secret backups (never committed). Used as a reference
# store so developers can relocate credentials out of tracked files
# without losing them. Rotate the real values when convenient.
.secrets.local/
**/.secrets.local/

# Test artefacts
playwright-report/
test-results/
coverage/

# Logs
*.log
logs/

# OS
Thumbs.db
Desktop.ini
